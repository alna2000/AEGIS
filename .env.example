AEGIS_APP_NAME=AEGIS
AEGIS_ENVIRONMENT=development
AEGIS_DEBUG=true
# Local example only: provide credentials through an untracked .env file.
AEGIS_DATABASE_URL=postgresql+psycopg://aegis_app@localhost:5432/aegis
# Local plain-HTTP development only. Production/public environments must set true.
AEGIS_SESSION_COOKIE_SECURE=false
AEGIS_SESSION_LIFETIME_SECONDS=28800
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_MFA_CHALLENGE_LIFETIME_SECONDS=300
AEGIS_MFA_CHALLENGE_COOKIE_NAME=aegis_mfa_challenge
# Required only when MFA functionality is invoked. Supply an independently
# generated URL-safe Base64 32-byte key in the untracked .env file; never commit it.
AEGIS_MFA_ENCRYPTION_KEY=
# Non-secret identifier stored with ciphertext to support future key rotation.
AEGIS_MFA_ENCRYPTION_KEY_ID=v1
